DJANGO_SETTINGS_MODULE=config.settings.development
SECRET_KEY=django-insecure-agrishare-super-secret-key-change-in-production-2026!
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database (Default uses SQLite if DATABASE_URL is not set)
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/agrishare

# JWT Configuration
ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=7
